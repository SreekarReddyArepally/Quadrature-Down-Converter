TEXT -216 -544 Left 2 !.tran 10m
TEXT -216 -592 Left 2 !.include UA741.301
TEXT -216 -640 Left 2 !.param R=10k
TEXT -216 -696 Left 2 !.include TSMC_180nm.txt
