TEXT 760 -912 Left 2 !*--- I-Channel Measurements ---\n.meas TRAN v_max_I MAX V(V_out_I) FROM 2m TO 5m\n.meas TRAN v_min_I MIN V(V_out_I) FROM 2m TO 5m\n.meas TRAN v_pp_I param (v_max_I - v_min_I)*1000\n \n*--- Q-Channel Measurements ---\n.meas TRAN v_max_Q MAX V(V_out_Q) FROM 2m TO 5m\n.meas TRAN v_min_Q MIN V(V_out_Q) FROM 2m TO 5m\n.meas TRAN v_pp_Q param (v_max_Q - v_min_Q)*1000
TEXT 1520 -912 Left 2 !*--- Beat Frequency Measurement ---\n.meas TRAN t_start WHEN V(V_out_I)=0.49 RISE=2 TD=2.0m\n.meas TRAN t_stop WHEN V(V_out_I)=0.49 RISE=3 TD=2.0m\n.meas TRAN beat_freq param 1/(t_stop-t_start)\n \n*--- Final Phase Difference ---\n.meas TRAN t1 WHEN V(V_out_I)=0.49 RISE=2 TD=2.0m\n.meas TRAN t2 WHEN V(V_out_Q)=0.49 RISE=2 TD=2.0m\n.meas TRAN final_phase param (t2-t1)*beat_freq*360
